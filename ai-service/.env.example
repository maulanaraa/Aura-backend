# Salin file ini jadi ".env" lalu sesuaikan (JANGAN commit ".env" ke git).

# Path ke folder ML relatif terhadap folder BE ini.
# Default (kalau dikosongkan): "../ai-pipeline"
ML_PROJECT_PATH=

# Path ke model .task MediaPipe. Default: {ML_PROJECT_PATH}/models/face_landmarker.task
MODEL_PATH=

# Origin FE yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu).
# Dev lokal Vite default: http://localhost:5173
ALLOWED_ORIGINS=

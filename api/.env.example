# ==============================================================================
# AuraAI Backend — environment configuration
# Copy this file to `.env` and fill in the real values. Never commit `.env`.
# ==============================================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Database (Supabase Postgres)
# Supabase → Project Settings → Database → Connection string
# ------------------------------------------------------------------------------
# Pooled connection (port 6543, "Transaction" mode / pgbouncer) — used for all
# normal query traffic at runtime. Must include ?pgbouncer=true.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (port 5432, no pooling) — required by `prisma migrate`
# (pgbouncer's transaction pooling mode doesn't support the session-level
# features migrations need). If you're not on Supabase / not using a pooler,
# it's fine to set this to the same value as DATABASE_URL.
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# Supabase Storage (scan selfie uploads)
# Supabase → Project Settings → API
# Leave BOTH empty to fall back to local disk storage (dev/CI only — not
# recommended in production, most hosts don't persist local disk across
# deploys). Must be set together — see src/config/env.ts.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Create this bucket in Supabase Storage (Public bucket, so scan selfies get
# a directly fetchable URL for CustomerLead.selfieUrl / affiliator dashboards).
SUPABASE_STORAGE_BUCKET=aura-scans

# Public base URL of this API — only used to build /uploads links when the
# local-disk storage fallback above is active. Not needed once Supabase
# Storage is configured.
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Email verification
# Public URL of the deployed frontend — used to build the link inside the
# verification email (FRONTEND_URL/verify-email?token=...).
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# Supabase Edge Function that sends the actual email via Resend — see
# supabase/functions/send-email. Deploy it with `supabase functions deploy
# send-email`, then set EMAIL_FUNCTION_URL to the URL Supabase gives you
# (https://<project-ref>.supabase.co/functions/v1/send-email).
# EMAIL_FUNCTION_SECRET must match the same-named secret you set on the Edge
# Function (`supabase secrets set EMAIL_FUNCTION_SECRET=...`) — it's how the
# function knows the request really came from this backend.
# Leave BOTH empty to fall back to logging the verification link instead of
# emailing it (dev/CI only).
EMAIL_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/send-email
EMAIL_FUNCTION_SECRET=your-shared-secret

# ------------------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Sign in with Google) — same Web application Client ID as the
# frontend's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=753017896399-84d4f349215564g4glkb1ofqdqt43np5.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# AI Service (face/undertone/personal-color prediction — see RFC-001 §5)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# CORS — the frontend's origin (Frontend-3.0's Vite dev server, or your
# deployed frontend URL)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Local-disk fallback only (legacy authenticated /scan route always uses this;
# the public /leads route uses it only when Supabase Storage isn't configured)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

BCRYPT_ROUNDS=12
LOG_LEVEL=info

# Reserved for future session / rate-limit store
REDIS_URL=redis://localhost:6379